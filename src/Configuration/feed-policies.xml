<feedPolicies>
  <!-- Binary field names match reference-layouts.xml aliases, not baseline byte offsets.
       Confirmed top-level names match XDR strings; reference paths map nested optional fields.
       Text/Identifier/Remark names remain where the exact business meaning is unconfirmed.
       ACI actions reflect the approved structure review; other feed actions are retained. -->
  <catalog>
    <!--Optional shared rules. Existing inline feed/field policies remain supported unchanged.-->
    <!-- maskCharacters="all" uses the actual value width, including punctuation and spaces.
         Three mixed PNR records use # so their literal * separators remain distinguishable.
         A field uses either policy="..." or inline rule attributes, never both. -->
    <policy id="MaskUnclassifiedIdentifier" identification="Known" entity="UNCLASSIFIED_IDENTIFIER" action="Mask" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskPerson" identification="Known" entity="PERSON" action="Mask" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskTicketReference" identification="Known" entity="TICKET_REFERENCE" action="Mask" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskDateOfBirth" identification="Known" action="Mask" entity="DATE_OF_BIRTH" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskGender" identification="Known" action="Mask" entity="GENDER" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskSensitiveAttribute" identification="Known" action="Mask" entity="SENSITIVE_ATTRIBUTE" maskCharacters="all" maskCharacter="#" />
    <policy id="MaskEmailAddress" identification="Known" action="Mask" entity="EMAIL_ADDRESS" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskPhoneNumber" identification="Known" action="Mask" entity="PHONE_NUMBER" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskLoyaltyNumber" identification="Known" action="Mask" entity="LOYALTY_NUMBER" maskCharacters="all" maskCharacter="#" />
    <policy id="MaskPaymentReference" identification="Known" action="Mask" entity="PAYMENT_REFERENCE" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskIpAddress" identification="Known" action="Mask" entity="IP_ADDRESS" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskFinancialInformation" identification="Known" action="Mask" entity="FINANCIAL_INFORMATION" maskCharacters="all" maskCharacter="#" />
    <policy id="MaskOrderId" identification="Known" action="Mask" entity="ORDER_ID" maskCharacters="all" maskCharacter="*" />
    <policy id="MaskAddress" identification="Known" action="Mask" entity="ADDRESS" maskCharacters="all" maskCharacter="*" />
  </catalog>

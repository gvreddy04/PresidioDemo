<Project Sdk="Microsoft.NET.Sdk">

  <!-- The deployable worker: Generic Host, configuration and one feed worker per route. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PresidioDemo.Core/PresidioDemo.Core.csproj" />
    <ProjectReference Include="../PresidioDemo.Messaging/PresidioDemo.Messaging.csproj" />
    <ProjectReference Include="../PresidioDemo.Messaging.Solace/PresidioDemo.Messaging.Solace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One settings file for every environment; DOTNET_ENVIRONMENT selects the section. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Recognizer files ship inside the build output and the image only (PR-005). -->
    <None Include="../PresidioDemo.Core/Configuration/recognizers/*.xml" Link="Configuration/recognizers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

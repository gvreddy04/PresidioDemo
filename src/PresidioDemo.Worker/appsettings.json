{
  "CurrentEnvironment": "Local",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },

  "Presidio": {
    "PolicyFile": "Configuration/feed-policies.xml",
    "XdrLayoutFile": "Configuration/xdr-layouts.xml",
    "ReferenceLayoutFile": "Configuration/reference-layouts.xml"
  },

  "Messaging": {
    "Transport": "Solace",
    "MaxDeliveries": 5,
    "PublishAckTimeoutMs": 10000,
    "PublishRetryDelayMs": 5000,
    "CopyHeaders": []
  },

  "Environments": {
    "Local": {
      "Messaging": {
        "Routes": [
          { "Feed": "ACI", "Input": "q.aci.raw", "Output": "airline/aci/protected", "DeadLetter": "q.aci.dlq" },
          { "Feed": "ETKT", "Input": "q.etkt.raw", "Output": "airline/etkt/protected", "DeadLetter": "q.etkt.dlq" },
          { "Feed": "PNR", "Input": "q.pnr.raw", "Output": "airline/pnr/protected", "DeadLetter": "q.pnr.dlq" },
          { "Feed": "PNR-Linking", "Input": "q.pnr-linking.raw", "Output": "airline/pnr-linking/protected", "DeadLetter": "q.pnr-linking.dlq" },
          { "Feed": "Seats", "Input": "q.seats.raw", "Output": "airline/seats/protected", "DeadLetter": "q.seats.dlq" }
        ]
      },
      "Solace": {
        "Host": "tcp://localhost:55555",
        "Vpn": "default",
        "Username": "presidio",
        "PasswordEnvironmentVariable": "SOLACE_PASSWORD",
        "ClientName": "presidio-worker-local",
        "ConnectRetries": 3,
        "ValidateCertificate": false,
        "ProvisionQueues": true
      }
    },
    "Dev": {
      "Messaging": {
        "Routes": [
          { "Feed": "ACI", "Input": "DEMOAIR.OPS.PIIDEMO.COS.ACI.MI.1", "Output": "demoair/ops/piidemo/aci/protected", "DeadLetter": "DEMOAIR.OPS.PIIDEMO.COS.ACI.DLQ.1" },
          { "Feed": "ETKT", "Input": "DEMOAIR.OPS.PIIDEMO.COS.TKT.MI.1", "Output": "demoair/ops/piidemo/tkt/protected", "DeadLetter": "DEMOAIR.OPS.PIIDEMO.COS.TKT.DLQ.1" },
          { "Feed": "PNR", "Input": "DEMOAIR.OPS.PIIDEMO.COS.PNR.MI.1", "Output": "demoair/ops/piidemo/pnr/protected", "DeadLetter": "DEMOAIR.OPS.PIIDEMO.COS.PNR.DLQ.1" }
        ]
      },
      "Solace": {
        "Host": "tcps://solace-dev.demoair.example:55443",
        "Vpn": "dev-demoair-vpn",
        "Username": "piidemo-app",
        "PasswordEnvironmentVariable": "SOLACE_PASSWORD",
        "ClientName": "piidemo-worker-dev",
        "UniqueClientName": true,
        "ConnectRetries": 3
      }
    }
  }
}

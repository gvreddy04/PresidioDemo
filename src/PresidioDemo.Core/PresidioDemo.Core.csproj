<Project Sdk="Microsoft.NET.Sdk">

  <!-- Feeds, parsers, serializers, protection and the broker-neutral processing pipeline. No broker libraries. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>PresidioDemo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PythonHost imports the bridge from python/ next to the application, so a container image needs no source tree. -->
    <None Update="Protection/Shared/python/presidio_demo.py" Link="python/presidio_demo.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

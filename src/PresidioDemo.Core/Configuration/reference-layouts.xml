    <text name="givenName" path="/firstNames/*/givenName" offset="0" length="0" />
    <text name="factCode" path="/facts/*/factCode" offset="0" length="0" />
    <text name="factText" path="/facts/*/text" offset="0" length="0">
      <variant pattern="DOCS[A-Z0-9]{2}[A-Z]{2}[0-9]+/(?&lt;DocumentType&gt;[^/]*)/(?&lt;IssuingCountry&gt;[^/]*)/(?&lt;DocumentNumber&gt;[^/]*)/(?&lt;Nationality&gt;[^/]*)/(?&lt;DateOfBirth&gt;[^/]*)/(?&lt;Gender&gt;[^/]*)/(?&lt;DocumentExpiry&gt;[^/]*)/(?&lt;PassengerName&gt;[^-]*)(?:-[0-9]+(?&lt;AssociatedName&gt;.*))?" />

<?xml version="1.0" encoding="utf-8"?>
<!--
  PNR recognizers. Records with a known syntax (DOCS, CTCE, CTCM, TKNE and labelled remarks) are keeps with scan="true":
  the record is published, and the personal-data spans the formats find inside it are masked. Any other string is
  masked across its full width unless a format matches it completely (WR-014). Loyalty, sensitive-attribute and
  financial values use # so literal * record separators stay distinguishable (WR-005); the default mask keeps literal *.
-->
<recognizers feed="PNR" threshold="0.5" defaultMaskCharacter="#">
  <!-- The PNR is the candidate just after the nine-digit creation time (WR-017). -->
  <pnrAnchor after="creationTime" offset="1" />

  <!-- Whole values. -->
  <format name="creationTime" entity="UNCLASSIFIED_IDENTIFIER" score="0.85" maskCharacter="*">
    <pattern>^\d{9}$</pattern>
  </format>

  <!-- Names: SURNAME/GIVEN, optionally with a title; also inside DOCS, CTCE, CTCM and TKNE. -->
  <format name="passengerName" entity="PERSON" score="0.9" maskCharacter="*">
    <pattern>(?&lt;![A-Z])[A-Z]{2,}(?:[ '-][A-Z]+)*/[A-Z]*(?:[ '-][A-Z]+)*</pattern>
  </format>
  <format name="memberName" entity="PERSON" score="0.9" maskCharacter="*">
    <pattern>(?&lt;=MBR )[A-Z]+(?: [A-Z]+)*(?=\*)</pattern>
    <context>MBR</context>
  </format>

  <!-- DOCS: type/issuing country/document number/nationality/date of birth/gender/expiry/name. -->
  <format name="dateOfBirth" entity="DATE_OF_BIRTH" score="0.9" maskCharacter="*">
    <pattern>(?&lt;=/)\d{2}[A-Z]{3}\d{2}(?=/[MFUX]I?/)</pattern>
    <context>DOCS</context>
  </format>
  <format name="gender" entity="GENDER" score="0.9" maskCharacter="*">
    <pattern>(?&lt;=/\d{2}[A-Z]{3}\d{2}/)[MFUX]I?(?=/)</pattern>
  </format>
  <format name="docsIssuingCountry" entity="SENSITIVE_ATTRIBUTE" score="0.85" maskCharacter="#">
    <pattern>(?&lt;=DOCS[A-Z0-9]{2}HK\d/[A-Z]{1,2}/)[A-Z]{2,3}(?=/)</pattern>
  </format>
  <format name="docsDocumentNumber" entity="UNCLASSIFIED_IDENTIFIER" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=DOCS[A-Z0-9]{2}HK\d/[A-Z]{0,2}/[A-Z]{0,3}/)[A-Z0-9]{3,20}(?=/)</pattern>
  </format>
  <format name="docsNationality" entity="SENSITIVE_ATTRIBUTE" score="0.85" maskCharacter="#">
    <pattern>(?&lt;=DOCS[A-Z0-9]{2}HK\d/[A-Z]{0,2}/[A-Z]{0,3}/[A-Z0-9]{0,20}/)[A-Z]{2,3}(?=/)</pattern>
  </format>
  <format name="docsExpiry" entity="SENSITIVE_ATTRIBUTE" score="0.85" maskCharacter="#">
    <pattern>(?&lt;=/[MFUX]I?/)\d{2}[A-Z]{3}\d{2}(?=/)</pattern>
  </format>

  <!-- Contacts: CTCE e-mail (@ written as //), CTCM phone, requested e-mail remark. -->
  <format name="ctceEmail" entity="EMAIL_ADDRESS" score="0.9" maskCharacter="*">
    <pattern>(?&lt;=CTCE[A-Z0-9]{2}HK\d/)[A-Z0-9._%+]+(?:-[A-Z0-9._%+]+)*//[A-Z0-9-]+(?:\.[A-Z0-9-]+)*\.[A-Z]{2,}</pattern>
  </format>
  <format name="requestedEmail" entity="EMAIL_ADDRESS" score="0.9" maskCharacter="*">
    <pattern>(?&lt;=EMAIL RQSTD )\S+</pattern>
  </format>
  <format name="ctcmPhone" entity="PHONE_NUMBER" score="0.9" maskCharacter="*">
    <pattern>(?&lt;=CTCM[A-Z0-9]{2}HK\d/)\d{6,15}</pattern>
  </format>

  <!-- Tickets, loyalty, payment and references in labelled records. -->
  <format name="ticketNumber" entity="TICKET_REFERENCE" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=\.)\d{13,14}(?=C\d)</pattern>
    <pattern>(?&lt;=/)\d{11,15}(?=/)</pattern>
  </format>
  <format name="loyaltyNumber" entity="LOYALTY_NUMBER" score="0.85" maskCharacter="#">
    <pattern>(?&lt;![0-9])[A-Z]{2}\d{6,12}(?!\d)</pattern>
  </format>
  <format name="loyaltyStatus" entity="SENSITIVE_ATTRIBUTE" score="0.85" maskCharacter="#">
    <pattern>(?&lt;=[A-Z]{2}\d{6,12}\.\d\*)[A-Z][A-Z ]*</pattern>
    <pattern>(?&lt;=ACCT [A-Z]{2}\d{6,12}\*)[A-Z]{1,4}(?=\*)</pattern>
  </format>
  <format name="accountBalance" entity="FINANCIAL_INFORMATION" score="0.85" maskCharacter="#">
    <pattern>(?&lt;=BALANCE )\d+</pattern>
  </format>
  <format name="cardSuffix" entity="PAYMENT_REFERENCE" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=X{4})\d{4}$</pattern>
  </format>
  <format name="approvalCode" entity="PAYMENT_REFERENCE" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=APPR CC [A-Z]{2} )\d{4,8}</pattern>
  </format>
  <format name="orderId" entity="ORDER_ID" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=(?:ORDERID|FQID)\*)[A-Z0-9-]+</pattern>
  </format>
  <format name="msoId" entity="UNCLASSIFIED_IDENTIFIER" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=MSO ID - )\d+</pattern>
  </format>
  <format name="rviId" entity="UNCLASSIFIED_IDENTIFIER" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=RVI ID\*)[A-Z0-9-]+</pattern>
  </format>
  <format name="address" entity="ADDRESS" score="0.85" maskCharacter="*">
    <pattern>(?&lt;=^ADDR(?:CITY|STATE|ZIP)? ).+</pattern>
  </format>

  <!-- Records published with their inner personal data masked. -->
  <keep name="docsRecord" scan="true"><pattern>DOCS[A-Z0-9]{2}HK\d/.*</pattern></keep>
  <keep name="emailRecord" scan="true"><pattern>CTCE[A-Z0-9]{2}HK\d/.*</pattern></keep>
  <keep name="phoneRecord" scan="true"><pattern>CTCM[A-Z0-9]{2}HK\d/.*</pattern></keep>
  <keep name="ticketRecord" scan="true"><pattern>TKNE[A-Z0-9]{2}HK\d.*</pattern></keep>
  <keep name="loyaltyRecord" scan="true"><pattern>[A-Z]{2}\d{6,12}\.\d\*[A-Z][A-Z ]*</pattern></keep>
  <keep name="memberRemark" scan="true"><pattern>ONE\*MBR [A-Z ]+\*ACCT [A-Z]{2}\d{6,12}\*[A-Z]{1,4}\*[A-Z]+</pattern></keep>
  <keep name="sponsorRemark" scan="true"><pattern>SPNSR\*ACCT [A-Z]{2}\d{6,12}\*[A-Z]+</pattern></keep>
  <keep name="balanceRemark" scan="true"><pattern>ACCOUNT BALANCE \d+\*.*</pattern></keep>
  <keep name="msoRemark" scan="true"><pattern>IATA MSO ID - \d+</pattern></keep>
  <keep name="emailRemark" scan="true"><pattern>EMAIL RQSTD \S+</pattern></keep>
  <keep name="orderRemark" scan="true"><pattern>(?:SFS FQID|PB TKT ORDERID|PB MILES ORDERID)\*[A-Z0-9-]+</pattern></keep>
  <keep name="addressRemark" scan="true"><pattern>ADDR(?:CITY|STATE|ZIP)? .+</pattern></keep>
  <keep name="rviRemark" scan="true"><pattern>RVI ID\*[A-Z0-9-]+</pattern></keep>
  <keep name="approvalRemark" scan="true"><pattern>RBY\d{1,2}[A-Z]{3}\*APPR CC [A-Z]{2} \d{4,8} .*</pattern></keep>
  <keep name="cardRemark" scan="true"><pattern>X{4,}\d{4}</pattern></keep>
  <keep name="ipRemark" scan="true"><pattern>WEB CLIENT IP \d{1,3}(?:\.\d{1,3}){3}</pattern></keep>
  <keep name="fareRecord" scan="true"><pattern>T/FQR/[A-Z]{2}[A-Z]{2}\d{6,12}/\d+/\d/\d{11,15}/\d{4}//</pattern></keep>
  <keep name="cocomRecord" scan="true"><pattern>COCOM-[A-Z]{2}/[A-Z]{2}\d{6,12}-GUID/</pattern></keep>

  <!-- Operational values published unchanged. -->
  <keep name="date"><pattern>\d{2}[A-Z]{3}\d{2}(?:\d{2})?</pattern></keep>
  <keep name="time"><pattern>\d{4}</pattern></keep>
  <keep name="loyaltyRecordCode"><pattern>FQT[RS]</pattern></keep>
  <keep name="fareQuote" scan="true"><pattern>FARE QUOTE-.*</pattern></keep>
  <keep name="totalFare"><pattern>TOTAL FARE - [A-Z]{3}[0-9.]+</pattern></keep>

  <builtIn entity="EMAIL_ADDRESS" />
  <builtIn entity="IP_ADDRESS" />
  <builtIn entity="CREDIT_CARD" />
  <builtIn entity="PERSON" />
</recognizers>

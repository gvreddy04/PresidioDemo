# Copy to deploy/.env.dev (git-ignored) and replace the DemoAir stand-ins with the real Dev values.
# Never commit the copy or put real values here: they identify the client's environment and include the password.
# Variables override the Dev section of appsettings.json; route indexes follow its order (0 ACI, 1 ETKT, 2 PNR).

SOLACE_PASSWORD=
Solace__Host=tcps://solace-dev.demoair.example:55443
Solace__Vpn=dev-demoair-vpn
Solace__Username=piidemo-app
Solace__ClientName=piidemo-worker-dev-docker
Solace__TrustStoreFolder=/app/certs

Messaging__Routes__0__Input=DEMOAIR.OPS.PIIDEMO.COS.ACI.MI.1
Messaging__Routes__0__Output=demoair/ops/piidemo/aci/protected
Messaging__Routes__0__DeadLetter=DEMOAIR.OPS.PIIDEMO.COS.ACI.DLQ.1
Messaging__Routes__1__Input=DEMOAIR.OPS.PIIDEMO.COS.TKT.MI.1
Messaging__Routes__1__Output=demoair/ops/piidemo/tkt/protected
Messaging__Routes__1__DeadLetter=DEMOAIR.OPS.PIIDEMO.COS.TKT.DLQ.1
Messaging__Routes__2__Input=DEMOAIR.OPS.PIIDEMO.COS.PNR.MI.1
Messaging__Routes__2__Output=demoair/ops/piidemo/pnr/protected
Messaging__Routes__2__DeadLetter=DEMOAIR.OPS.PIIDEMO.COS.PNR.DLQ.1
